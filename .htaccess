# Configuración Apache - Versión Simplificada
# Si aún tienes error 500, prueba renombrar este archivo a .htaccess.backup temporalmente

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si la app está en un subdirectorio, descomenta y ajusta:
    # RewriteBase /subdirectorio/
    
    # Solo redirigir si el archivo no existe físicamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Si tienes problemas, comenta todo lo demás y deja solo esto arriba
